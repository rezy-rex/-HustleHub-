# Application environment (development, production, test)
NODE_ENV=development

# Server port number
PORT=5000

# Secret key for signing JSON Web Tokens (min 32 characters)
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# Expiration duration for signed JWT tokens
JWT_EXPIRES_IN=1h

# Path to the SSL/TLS private key file
HTTPS_KEY_PATH=./certs/localhost-key.pem

# Path to the SSL/TLS certificate file
HTTPS_CERT_PATH=./certs/localhost.pem

# MongoDB connection string URI
MONGODB_URI=your-atlas-connection-string/hustlehub?retryWrites=true&w=majority

# Minimum logging level (debug, info, warn, error, silent)
LOG_LEVEL=info

# Axiom API token for remote logging ingestion
AXIOM_TOKEN=

# Axiom dataset name for remote log storage
AXIOM_DATASET=

# Optional custom Axiom ingestion URL
AXIOM_URL=

# Maximum consecutive failed login attempts before account lockout
LOGIN_MAX_FAILURES=3

# Duration of account lockout in minutes after exceeding max failures
LOCKOUT_MINUTES=15

# Maximum authentication requests allowed per rate limit window
AUTH_RATE_LIMIT_MAX=5

# Maximum booking requests allowed per rate limit window
BOOKING_RATE_LIMIT_MAX=10

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Express trust proxy hop count (0 to disable)
TRUST_PROXY=0
